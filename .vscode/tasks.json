{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "process",
            "label": "Build bookstore",
            "command": "/usr/bin/clang++",
            "args": [
                "-std=c++17",
                "-Wall",
                "-Wextra",
                "-pedantic",
                "${workspaceFolder}/main.cpp",
                "${workspaceFolder}/implementation.cpp",
                "-o",
                "${workspaceFolder}/output/bookstore"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$gcc",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "type": "process",
            "label": "Run bookstore",
            "command": "${workspaceFolder}/output/bookstore",
            "dependsOn": "Build bookstore",
            "dependsOrder": "sequence",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}
